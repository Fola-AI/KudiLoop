{
  "expo": {
    "name": "KudiLoop",
    "slug": "kudiloop",
    "scheme": "kudiloop",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "newArchEnabled": true,
      "supportsTablet": false,
      "bundleIdentifier": "com.kudiloop.app",
      "buildNumber": "15",
      "associatedDomains": [
        "applinks:kudiloop.com",
        "applinks:www.kudiloop.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "KudiLoop needs camera access to take photos of payment receipts.",
        "NSPhotoLibraryUsageDescription": "KudiLoop needs photo library access to upload payment receipts.",
        "NSFaceIDUsageDescription": "KudiLoop uses Face ID for secure authentication.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "kudiloop"
            ]
          }
        ]
      }
    },
    "android": {
      "newArchEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.kudiloop.app",
      "versionCode": 14,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kudiloop.com",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "www.kudiloop.com",
              "pathPrefix": "/join"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "kudiloop"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF6B35"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KudiLoop needs access to your photos to upload payment receipts.",
          "cameraPermission": "KudiLoop needs access to your camera to take photos of payment receipts."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "KudiLoop uses Face ID for secure authentication."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8fa91152-38cb-427d-84ac-6f640446bc2e"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/8fa91152-38cb-427d-84ac-6f640446bc2e"
    }
  }
}
